# dArchiva Deployment Configuration
# Copy from .env.deploy.example and fill in your values.
# Do NOT commit real server addresses or credentials here.

# Remote server
DEPLOY_HOST=your-server.example.com

# SSH user for deployment
DEPLOY_USER=deploy

# Remote deployment path
DEPLOY_PATH=/opt/darchiva

# Git branch to deploy
DEPLOY_BRANCH=main

# PM2 app name prefix
PM2_APP_NAME=darchiva
